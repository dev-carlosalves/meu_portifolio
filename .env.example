# Variáveis de ambiente — Portfólio de Carlos Daniel
# Copie este arquivo para .env e preencha os valores reais.

# ── EmailJS (Sprint 7) ─────────────────────────────────────────
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key

# ── Servidor (desenvolvimento) ─────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=true

# ── SEO / Deploy (produção) ────────────────────────────────────────
BASE_URL=https://carlosdaniel.dev

# ── Vercel Blob (armazenamento de dados das trilhas) ───────────────
# Token de leitura/escrita do Blob Store criado no dashboard da Vercel.
# Como obter:
#   1. Acesse https://vercel.com/dashboard → seu projeto → aba Storage
#   2. Crie um Blob Store (caso ainda não exista)
#   3. Abra o Blob Store → Settings → copie o BLOB_READ_WRITE_TOKEN
# O mesmo token é usado localmente e em produção (mesmo Blob Store).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
